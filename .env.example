# RPC endpoints (Ethereum Mainnet and Base Mainnet)
ETHEREUM_RPC_URL=
BASE_RPC_URL=

# OpenServ SERV provider
SERV_API_KEY=
SERV_MODEL=serv-mini

# Dolphin provider
DOLPHIN_API_KEY=
DOLPHIN_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Optional Vercel KV / Upstash Redis for distributed cache across serverless instances
# (If omitted, CallScope automatically falls back to per-instance LRU memory and stateless recomputation)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Or Upstash Redis directly:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

